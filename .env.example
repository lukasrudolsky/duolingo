# Copy to .env.local for local dev: cp .env.example .env.local
# See CONTRIBUTING.md for the full local setup (docker-compose or native Postgres/Redis).

# --- Database -----------------------------------------------------------
# Local dev default matches docker-compose.yml / a native `duolingo` role+db.
DATABASE_URL="postgresql://duolingo:duolingo_dev_password@localhost:5432/duolingo_dev"

# --- Cache ---------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth. Leave empty in dev: the Google sign-in button stays hidden, not broken.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (magic link email). Leave empty in dev: the link is logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@dev.local"

# --- Observability ---------------------------------------------------------
# DSN is not a secret (write-only), safe to expose to the client.
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed for source map upload on build (Vercel/CI), not for local dev.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
